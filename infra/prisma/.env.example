# ═══════════════════════════════════════════════════════════════════════════
# Stack LXP de PRODUCCIÓN (/var/www/prisma) — PLANTILLA de variables.
# El .env REAL vive SOLO en el VPS (/var/www/prisma/.env) y NO se versiona.
# Valores reales = perfil .env.supabase (Supabase cloud · §1/§10) + creds propias
# del Redis/MinIO del LXP. CERO secretos en este archivo.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase CLOUD (compartida con CORA · prod) ──
# Runtime (web/api/worker): POOLER de transacción :6543 → prepare:false.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# service_role: SOLO api/worker (nunca web · §10).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Redis PROPIO del LXP (interno, nunca expuesto) ──
REDIS_PASSWORD=<genera-uno-fuerte>

# ── MinIO PROPIO del LXP (interno) ──
STORAGE_ACCESS_KEY_ID=<minio-user>
STORAGE_SECRET_ACCESS_KEY=<minio-password>
STORAGE_BUCKET=campus-lxp-media
# Host PÚBLICO (https) que verá el NAVEGADOR en las URLs firmadas (upload/lectura
# presigned directo). Expuesto por Traefik → service minio (router prisma-s3). El
# `api` lo firma; el endpoint interno (http://minio:9000) lo usan worker/api server-side.
STORAGE_ENDPOINT_PUBLICO=https://s3-prisma.medicacapacitacion.com

# ── Traefik basic-auth (fase privada) — user:hash (htpasswd/openssl apr1) ──
# Generar:  openssl passwd -apr1 '<password>'   →  PRISMA_BASICAUTH=medica:$apr1$....
PRISMA_BASICAUTH=<user>:<hash-apr1>

# ── Eco (opcional en el humo; MOCK si se omite) ──
ECO_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GIPHY_API_KEY=
