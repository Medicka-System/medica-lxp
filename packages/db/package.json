{
  "name": "@campus/db",
  "version": "0.0.0",
  "private": true,
  "description": "Esquema (schema lxp), migraciones SQL, cliente Drizzle y seed. ORM: Drizzle (Sprint 1).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "migrate:new": "tsx src/migrate.ts new",
    "migrate:up": "tsx src/migrate.ts up",
    "seed": "tsx src/seed.ts",
    "seed:clean": "tsx src/seed.ts --clean",
    "test:rls": "tsx src/test-rls.ts",
    "test:model": "tsx src/test-modelo.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@campus/config": "workspace:*",
    "@types/node": "^20.17.10",
    "drizzle-kit": "^0.30.1",
    "eslint": "^8.57.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
