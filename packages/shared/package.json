{
  "name": "@campus/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos TS + esquemas zod + contratos compartidos (front/back)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@campus/config": "workspace:*",
    "eslint": "^8.57.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
