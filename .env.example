# ═══════════════════════════════════════════════════════════════════════════
# Campus Virtual LXP · Médica Capacitación — variables de entorno (plantilla)
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` al repo.
# Sprint 0: solo se usan de verdad las de App, Postgres y Redis. El resto queda
# declarado para los sprints siguientes (no borrar).
#
# DOS PERFILES (§10, para que migrar prod por accidente sea imposible):
#   • `.env` (este) = LOCAL. Apunta SOLO a los contenedores del compose (127.0.0.1),
#     un único DATABASE_URL directo :5432, MIGRATION_TARGET=local. Se carga siempre.
#   • `.env.supabase` = REMOTO (Supabase compartida con CORA · prod). Contiene
#     DATABASE_URL :6543 ?pgbouncer=true, DIRECT_URL :5432, SUPABASE_* y
#     MIGRATION_TARGET=supabase. NO se carga por default: solo con ENV_FILE, p. ej.
#       ENV_FILE=.env.supabase pnpm --filter @campus/db migrate:up
#     (ENV_FILE superpone ese perfil por encima de .env · packages/db/src/env.ts).
#   Candados: target=local RECHAZA hosts remotos; target=supabase solo por valor
#   EXPLÍCITO 'supabase' (nunca default ni typo). Ver packages/db/src/migrate.ts.
#   Ambos `.env*` (salvo este .example) están gitignoreados.
# ═══════════════════════════════════════════════════════════════════════════

# ── Entorno ──
NODE_ENV=development

# ── App: puertos y URLs ──
WEB_PORT=3000
API_PORT=8000
# URL de la API que consume el front (browser). En docker: http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL pública del campus (deep-links, PWA)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Portal de CORA (el ERP · §1) — base para deep-links salientes: checkout de inscripción
# ("Inscribirme" en Explorar → <CORA_URL>/checkout?programa=<id>) y consultas de grupo del
# docente. Vacío en local → los CTA caen a un placeholder interno, nunca a un enlace roto.
# La ruta/host real se confirma en el Sprint 11 (integración CORA).
NEXT_PUBLIC_CORA_URL=

# ── Postgres LOCAL (contenedor del compose). Perfil .env → un solo DATABASE_URL. ──
POSTGRES_USER=lxp
POSTGRES_PASSWORD=lxp_dev_password
POSTGRES_DB=campus_lxp
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_URL = conexión de RUNTIME (api/worker/web). En .env (LOCAL) = Postgres
# directo :5432. En .env.supabase = POOLER de transacción :6543 (Supavisor) +
# ?pgbouncer=true; el cliente de runtime usa prepare:false (el pooler en modo
# transacción no admite prepared statements · client.ts).
DATABASE_URL=postgresql://lxp:lxp_dev_password@127.0.0.1:5432/campus_lxp
# MIGRATION_TARGET = perfil de destino del runner (packages/db/migrate.ts).
#   local (default) → aplica TODO, incl. shims [SOLO_LOCAL] (0000 auth + 0009 CORA mock).
#                     RECHAZA correr contra un host remoto (candado verificarDestino).
#   supabase        → SOLO en .env.supabase (valor explícito). OMITE los [SOLO_LOCAL];
#                     los puentes lxp.cora_* SÍ corren (leen el public.* real de CORA).
MIGRATION_TARGET=local
# AUTH_MODE = origen de la identidad. `dev` (default) = DEV_ALUMNO_EMAIL (seed, sin
# Supabase). `supabase` (solo en .env.supabase) = sub del JWT de la sesión Supabase.
AUTH_MODE=dev
DEV_ALUMNO_EMAIL=a1@seed.local
DEV_STAFF_EMAIL=admin-studio@seed.local

# ── Perfil REMOTO → va en `.env.supabase`, NO aquí (se carga con ENV_FILE) ──
# Añade también: AUTH_MODE=supabase. El `api` necesita SUPABASE_JWT_JWKS_URL (guard JWT ES256).
# En .env (LOCAL) estas quedan VACÍAS/ausentes. La plantilla del perfil remoto:
#   MIGRATION_TARGET=supabase
#   DATABASE_URL=postgresql://postgres.<ref>:<pwd>@aws-<n>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.<ref>:<pwd>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#   SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY (SOLO api/worker, JAMÁS en web · §5)
#   SUPABASE_JWT_JWKS_URL
# DIRECT_URL = conexión DIRECTA de SESIÓN para DDL. En LOCAL no se define (el runner
# cae a DATABASE_URL); en Supabase apunta a :5432 (el pooler :6543 no sirve para DDL).
DIRECT_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role SOLO en api/worker, JAMÁS en web (§5)
SUPABASE_SERVICE_ROLE_KEY=
# JWKS para verificar la firma del JWT en el guard de NestJS (§10)
SUPABASE_JWT_JWKS_URL=

# ── Redis (propio del LXP, separado del de CORA/CRM — §3) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── LRS · SQL LRS de Yet Analytics (Sprint 2) ──
# En host, el endpoint xAPI es localhost:8080/xapi; en la red docker es lrs:8080/xapi.
LRS_ENDPOINT=http://localhost:8080/xapi
LRS_PORT=8080
# Credencial Basic auth del endpoint xAPI (siembra LRSQL_API_KEY/SECRET_DEFAULT).
LRS_KEY=campuslxp
LRS_SECRET=campuslxp_dev_secret
# Admin UI del LRS (solo inspección local).
LRS_ADMIN_USER=admin
LRS_ADMIN_PASS=campuslxp_admin

# ── Object storage · MinIO local → Supabase Storage → R2 al escalar (§3/§9) ──
# El `api` firma URLs con SPLIT de host (ver docker-compose.yml + StorageService):
#  · STORAGE_ENDPOINT (INTERNO): lo usan el worker y el `api` server-side (/procesar de
#    imágenes de reporte) DENTRO de Docker.
#  · STORAGE_ENDPOINT_PUBLICO: host que verá el NAVEGADOR en las URLs firmadas (upload/
#    lectura directos: ingesta DICOM, galería del reporte, visor).
# Modo híbrido (Docker infra + `pnpm dev` web en host): el `api`/worker corren en Docker →
# toman los defaults del compose (interno http://minio:9000 + público http://localhost:9000);
# este .env del root NO se pasa a esos contenedores. Si corres el `api` TAMBIÉN en host,
# ambos = http://localhost:9000. La firma SigV4 va contra el host usado → no los mezcles.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ENDPOINT_PUBLICO=http://localhost:9000
STORAGE_REGION=auto
# Credenciales de MinIO local (== MINIO_ROOT_USER / MINIO_ROOT_PASSWORD del compose).
STORAGE_ACCESS_KEY_ID=lxpminio
STORAGE_SECRET_ACCESS_KEY=lxpminio_dev_secret
STORAGE_BUCKET=campus-lxp-media
# Puertos de MinIO: 9000 = API S3, 9001 = consola web (http://localhost:9001).
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Cloudflare Stream (video adaptativo)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# ── Zoom (clases en vivo · Sprint 6) ──
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── IA · Eco (modelo-agnóstico; Anthropic por default — §3/§7A) ──
ECO_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelos por rol del pipeline (recopilar/clasificar vs juicio)
ECO_MODEL_CLASIFICADOR=claude-haiku-4-5
ECO_MODEL_JUICIO=claude-sonnet-4-6
ECO_MODEL_EXCEPCION=claude-opus-4-8
# Umbral de confianza para separar "listos" vs "requieren criterio" (0-1)
ECO_UMBRAL_CONFIANZA=0.8

# ── Giphy · GIFs del Ateneo (§3) ──
# Key del proxy de GIFs (/media/gifs/*). Vive SOLO en el api, nunca en el cliente.
# Consíguela en https://developers.giphy.com. Sin key → el picker muestra 503 (no crashea).
GIPHY_API_KEY=

# ── Embeddings self-hosted · BGE-M3 (servicio Python local · Sprint 5.3) ──
# En host: localhost:8001; en la red docker: http://embeddings:8001.
EMBEDDINGS_URL=http://localhost:8001
EMBEDDINGS_PORT=8001
EMBEDDINGS_MODEL=BAAI/bge-m3
# URL interna del api que el worker `eco-evaluacion` invoca (red docker: http://api:8000).
API_URL=http://localhost:8000

# ── Observabilidad (§11) ──
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# ── Notificaciones · correo Resend (Sprint 8.5) ──
# Proveedor de correo (adaptador intercambiable, mismo patrón que Eco): 'resend' | 'mock'.
# Vacío → usa resend si hay RESEND_API_KEY, si no MOCK (arranca sin secretos). 'mock' fuerza MOCK.
NOTIFICACIONES_PROVIDER=
RESEND_API_KEY=
NOTIFICACIONES_FROM_EMAIL=campus@medicacapacitacion.com
