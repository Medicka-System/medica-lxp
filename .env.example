# ═══════════════════════════════════════════════════════════════════════════
# Campus Virtual LXP · Médica Capacitación — variables de entorno (plantilla)
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` al repo.
# Sprint 0: solo se usan de verdad las de App, Postgres y Redis. El resto queda
# declarado para los sprints siguientes (no borrar).
# ═══════════════════════════════════════════════════════════════════════════

# ── Entorno ──
NODE_ENV=development

# ── App: puertos y URLs ──
WEB_PORT=3000
API_PORT=8000
# URL de la API que consume el front (browser). En docker: http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL pública del campus (deep-links, PWA)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Postgres local (Supabase self-hosted a futuro; en local, contenedor propio) ──
POSTGRES_USER=lxp
POSTGRES_PASSWORD=lxp_dev_password
POSTGRES_DB=campus_lxp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lxp:lxp_dev_password@localhost:5432/campus_lxp

# ── Supabase (compartido con CORA — §1/§10). En local usamos Postgres directo;
#    estas se cablean cuando se levante Supabase self-hosted / cloud. ──
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role SOLO en api/worker, JAMÁS en web (§5)
SUPABASE_SERVICE_ROLE_KEY=
# JWKS para verificar la firma del JWT en el guard de NestJS (§10)
SUPABASE_JWT_JWKS_URL=

# ── Redis (propio del LXP, separado del de CORA/CRM — §3) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── LRS · SQL LRS de Yet Analytics (Sprint 2) ──
# En host, el endpoint xAPI es localhost:8080/xapi; en la red docker es lrs:8080/xapi.
LRS_ENDPOINT=http://localhost:8080/xapi
LRS_PORT=8080
# Credencial Basic auth del endpoint xAPI (siembra LRSQL_API_KEY/SECRET_DEFAULT).
LRS_KEY=campuslxp
LRS_SECRET=campuslxp_dev_secret
# Admin UI del LRS (solo inspección local).
LRS_ADMIN_USER=admin
LRS_ADMIN_PASS=campuslxp_admin

# ── Object storage · MinIO local → Supabase Storage → R2 al escalar (§3/§9) ──
# IMPORTANTE (modo híbrido: Docker infra + `pnpm dev` en host): STORAGE_ENDPOINT
# debe ser un host que el navegador TAMBIÉN alcance, porque el `api` firma la URL
# sobre ese host y el navegador (subida) y el visor (lectura) la usan tal cual.
# En híbrido usa http://localhost:9000. Solo en full-compose el `api`/worker usan
# la red interna http://minio:9000 (se sobreescribe por el compose).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
# Credenciales de MinIO local (== MINIO_ROOT_USER / MINIO_ROOT_PASSWORD del compose).
STORAGE_ACCESS_KEY_ID=lxpminio
STORAGE_SECRET_ACCESS_KEY=lxpminio_dev_secret
STORAGE_BUCKET=campus-lxp-media
# Puertos de MinIO: 9000 = API S3, 9001 = consola web (http://localhost:9001).
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# Cloudflare Stream (video adaptativo)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# ── Zoom (clases en vivo · Sprint 6) ──
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── IA · Eco (modelo-agnóstico; Anthropic por default — §3/§7A) ──
ECO_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelos por rol del pipeline (recopilar/clasificar vs juicio)
ECO_MODEL_CLASIFICADOR=claude-haiku-4-5
ECO_MODEL_JUICIO=claude-sonnet-4-6
ECO_MODEL_EXCEPCION=claude-opus-4-8
# Umbral de confianza para separar "listos" vs "requieren criterio" (0-1)
ECO_UMBRAL_CONFIANZA=0.8

# ── Embeddings self-hosted · BGE-M3 (servicio Python local · Sprint 5.3) ──
# En host: localhost:8001; en la red docker: http://embeddings:8001.
EMBEDDINGS_URL=http://localhost:8001
EMBEDDINGS_PORT=8001
EMBEDDINGS_MODEL=BAAI/bge-m3
# URL interna del api que el worker `eco-evaluacion` invoca (red docker: http://api:8000).
API_URL=http://localhost:8000

# ── Observabilidad (§11) ──
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# ── Notificaciones · correo Resend (Sprint 8.5) ──
# Proveedor de correo (adaptador intercambiable, mismo patrón que Eco): 'resend' | 'mock'.
# Vacío → usa resend si hay RESEND_API_KEY, si no MOCK (arranca sin secretos). 'mock' fuerza MOCK.
NOTIFICACIONES_PROVIDER=
RESEND_API_KEY=
NOTIFICACIONES_FROM_EMAIL=campus@medicacapacitacion.com
